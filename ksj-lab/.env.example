# ─────────────────────────────────────────────────────────────
# SQL Injection Lab — 환경변수 예시.  cp .env.example .env 후 값을 바꾸세요.
# 이 파일(.env.example)은 커밋 대상, 실제 .env 는 커밋 금지(.gitignore).
# ─────────────────────────────────────────────────────────────

# 실습 범위. SQLI = 이번 수업(§9). LFI/웹셸/OUTFILE 등은 SQLI 모드에서 차단.
LAB_SCOPE=SQLI

# DB 이름
LAB_DB_NAME=sbadmin

# DB root — 초기화 전용. 웹 앱은 절대 사용하지 않음.
MARIADB_ROOT_PASSWORD=change-me-root-Only-For-Init

# 웹 애플리케이션 계정 (최소권한: SELECT/INSERT/UPDATE)
LAB_APP_USER=lab_app
LAB_APP_PASSWORD=change-me-app

# 제한 계정 (지정 View 만 SELECT) — 최소권한 비교 실습(Level 15)
LAB_LIMITED_USER=lab_limited
LAB_LIMITED_PASSWORD=change-me-limited

# Observer 로그 조회 계정 (읽기 전용)
LAB_OBSERVER_USER=lab_observer
LAB_OBSERVER_PASSWORD=change-me-observer

# 강사 관리 계정 (phpMyAdmin 로그인 등)
LAB_INSTRUCTOR_USER=lab_instructor
LAB_INSTRUCTOR_PASSWORD=change-me-instructor

# Observer 강사 모드 토큰. 하드코딩 금지 — 반드시 여기서 바꾸세요.
INSTRUCTOR_TOKEN=change-me-a-long-random-token

# Time-based 실습 지연 상한(초) — 수업시간 고려 1~2초 권장
LAB_TIME_MAX_SECONDS=2

# 호스트 포트. 이미 실행 중인 실습과 겹치면 변경하세요.
WEB_PORT=8000
OBSERVER_PORT=8002
PMA_PORT=8001
WEBGOAT_PORT=8083
WEBWOLF_PORT=9090
